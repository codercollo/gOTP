# GoTP — example environment. Copy to .env and fill in.

# HTTP server
PORT=4000
ENV=development

# OTP behaviour
OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5

# Africa's Talking SMS. If AT_API_KEY/AT_USERNAME are empty, GoTP uses a no-op
# sender that logs instead (development / demo without live credentials).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# SIM-swap check via AT Insights (see internal/insights: endpoint must be
# confirmed before enabling in production).
SIM_SWAP_CHECK=false

# Per-IP rate limiter
LIMITER_ENABLED=true
LIMITER_RPS=2
LIMITER_BURST=5

# Fraud guard
GUARD_VELOCITY_CAPACITY=5
GUARD_VELOCITY_REFILL=0.2
GUARD_RATIO_PREFIX_LEN=6
GUARD_RATIO_MIN_SENDS=20
GUARD_RATIO_MAX=10

# Tenant API keys (comma-separated). Empty = auth disabled (development).
# Sent by clients in the X-API-Key header; stored only as SHA-256 hashes.
API_KEYS=
